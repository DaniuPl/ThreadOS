Gaps between flex items and lines: the items share the main size less
the gaps, lines wrap with them counted, and lines are that far apart.
A grid goes to _render_grid instead.

--- a/src/render_flex.cpp
+++ b/src/render_flex.cpp
@@ -2,10 +2,35 @@
 #include "render_flex.h"
 #include "html_tag.h"
 
+// patched in: the gap between flex items along an axis. A percentage is
+// of the container's width; of its height only when that is fixed, as
+// it is not known otherwise.
+static litehtml::pixel_t flex_gap(const litehtml::css_properties& css,
+                                  const litehtml::containing_block_context& self_size, bool row_gap)
+{
+    using namespace litehtml;
+    const css_length& g = row_gap ? css.m_row_gap : css.m_column_gap;
+    if(g.is_predefined())
+    {
+        return 0_px;
+    }
+    if(!row_gap)
+    {
+        return g.calc_percent(self_size.render_width);
+    }
+    return self_size.height.type == containing_block_context::cbc_value_type_absolute
+               ? g.calc_percent(self_size.height)
+               : (g.units() == css_units_percentage && !g.has_calc() ? 0_px : g.calc_percent(0_px));
+}
