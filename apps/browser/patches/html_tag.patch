+    // patched in: does an element in the place each selector of :has()
+    // says - below, a child, the next sibling, a later one - match it?
+    bool html_tag::has_relative(const css_attribute_selector& sel)
+    {
+        std::function<bool(const element::ptr&, const css_selector&)> below =
+            [&below](const element::ptr& el, const css_selector& s) {
+                for(const auto& c : el->children())
+                {
+                    if(c->select(s, true) || below(c, s))
+                    {
+                        return true;
+                    }
+                }
+                return false;
+            };
+        for(size_t i = 0; i < sel.selector_list.size() && i < sel.value.size(); i++)
+        {
+            const css_selector& s = *sel.selector_list[i];
+            char                comb = sel.value[i];
+            if(comb == ' ' && below(shared_from_this(), s))
+            {
+                return true;
+            }
+            if(comb == '>')
+            {
+                for(const auto& c : children())
+                {
+                    if(c->select(s, true))
+                    {
+                        return true;
+                    }
+                }
+            }
+            if((comb == '+' || comb == '~') && parent())
+            {
+                bool after = false;
+                for(const auto& c : parent()->children())
+                {
+                    if(c.get() == this)
+                    {
+                        after = true;
+                    } else if(after && !c->is_text() && !c->is_comment())
+                    {
+                        if(c->select(s, true))
+                        {
+                            return true;
+                        }
+                        if(comb == '+')
+                        {
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        return false;
+    }
+
