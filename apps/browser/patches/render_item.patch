+litehtml::pixel_t litehtml::render_item::translate_x() const
+{
+    const auto& t = src_el()->css().m_translate;
+    return t.empty() ? 0_px
+                     : t[0].calc_percent(m_pos.width + m_padding.left + m_padding.right + m_borders.left +
+                                         m_borders.right);
+}
+
+litehtml::pixel_t litehtml::render_item::translate_y() const
+{
+    const auto& t = src_el()->css().m_translate;
+    return t.size() < 2 ? 0_px
+                        : t[1].calc_percent(m_pos.height + m_padding.top + m_padding.bottom + m_borders.top +
+                                            m_borders.bottom);
+}
+
+// x, y: where the element is drawn from, as draw() is given it
+bool litehtml::render_item::push_clip(pixel_t x, pixel_t y)
+{
+    const auto& css   = src_el()->css();
+    bool        inset = !css.m_clip_path.empty();
+    const auto& v     = inset ? css.m_clip_path : css.m_clip_rect;
+    if(v.size() != 4)
+    {
+        return false;
+    }
+    position box  = m_pos;
+    box.x        += x;
+    box.y        += y;
+    box          += m_padding;
+    box          += m_borders;
+    position c    = box;
+    auto     len  = [](const css_length& l, pixel_t base, pixel_t dflt) {
+        return l.is_predefined() ? dflt : l.calc_percent(base);
+    };
+    if(inset)
+    {
+        pixel_t t = len(v[0], box.height, 0_px), r = len(v[1], box.width, 0_px);
+        pixel_t b = len(v[2], box.height, 0_px), l = len(v[3], box.width, 0_px);
+        c.x      += l;
+        c.y      += t;
+        c.width  -= l + r;
+        c.height -= t + b;
+    } else
+    {
+        // rect()'s right and bottom are from the left and top too
+        pixel_t t = len(v[0], box.height, 0_px), r = len(v[1], box.width, box.width);
+        pixel_t b = len(v[2], box.height, box.height), l = len(v[3], box.width, 0_px);
+        c.x      = box.x + l;
+        c.y      = box.y + t;
+        c.width  = r - l;
+        c.height = b - t;
+    }
+    c.width  = std::max(c.width, 0_px);
+    c.height = std::max(c.height, 0_px);
+    src_el()->get_document()->container()->set_clip(c, border_radiuses());
+    return true;
+}
