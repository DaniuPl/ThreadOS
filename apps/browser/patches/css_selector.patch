+                char comb = ' ';
+                while(!list.empty() && list.front().type == WHITESPACE)
+                {
+                    list.erase(list.begin());
+                }
+                if(!list.empty() && is_one_of(list.front().ch, '>', '+', '~'))
+                {
+                    comb = static_cast<char>(list.front().ch);
+                    list.erase(list.begin());
+                }
+                css_selector::ptr sel = parse_complex_selector(list, mode);
+                if(!sel)
+                {
+                    return {};
+                }
+                selector.selector_list.push_back(sel);
+                selector.value += comb;
+            }
+            if(selector.selector_list.empty())
+            {
+                return {};
+            }
+            return selector;
